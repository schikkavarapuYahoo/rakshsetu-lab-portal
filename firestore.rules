// EMULATOR-ONLY rules. The emulator skips real auth, so these are
// intentionally permissive — everything is open inside the local
// container. NEVER deploy this to a real Firebase project.
//
// When we wire the production Firebase project, this file gets
// replaced with proper per-lab + per-role access controls (RLS-style
// rules using request.auth.token.role and request.auth.token.labId).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
