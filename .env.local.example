# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real credentials.
#
# ──────────────────────────────────────────────────────────────────────
#  Two modes of running the app
# ──────────────────────────────────────────────────────────────────────
#
#  1. LOCAL EMULATOR (default for development)
#     No Firebase project needed. Run:
#         npm run emu:up        # boots Docker + Firebase emulator
#         npm run emu:seed      # provisions demo lab + users + reports
#         npm run dev:emu       # Next.js dev server pointed at emulator
#     The `dev:emu` script sets FIRESTORE_EMULATOR_HOST,
#     FIREBASE_AUTH_EMULATOR_HOST, FIREBASE_STORAGE_EMULATOR_HOST and
#     GCLOUD_PROJECT inline, so you only need JWT_SECRET below.
#
#  2. REAL FIREBASE (staging / production)
#     Requires a service-account JSON + the NEXT_PUBLIC_FIREBASE_* keys
#     from the Firebase console (Project settings → General + Service
#     accounts). Uncomment one credential strategy and the public keys.

# ──────────────────────────────────────────────────────────────────────
#  Required (both modes)
# ──────────────────────────────────────────────────────────────────────

# Signs the rs_lab_session JWT cookie. Must be ≥ 32 chars. When unset
# or shorter than 32, proxy.ts bypasses session enforcement entirely —
# useful for "auth-off" sandboxing but never desirable in real use.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotate quarterly. NEVER commit this.
JWT_SECRET=replace-with-32-plus-chars-of-randomness

# ──────────────────────────────────────────────────────────────────────
#  Real Firebase only — leave commented out for emulator mode
# ──────────────────────────────────────────────────────────────────────

# Pick ONE of the three credential strategies. The Admin SDK tries them
# in this order — first non-empty wins.

# (a) Absolute path to service-account JSON. Easiest for local dev
#     against a real (non-emulator) Firebase project.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json

# (b) Inline JSON, all on one line. Wrap in single quotes to preserve
#     the internal double quotes. Best for Vercel / hosted envs where
#     you can't upload a file.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"...",...}'

# (c) Google standard env var — Cloud Run, App Engine, etc.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Firebase project ID. Read by `server/firebase-admin.ts` as a fallback
# when `GCLOUD_PROJECT` isn't set. Set this to the same project ID as
# the service-account JSON above.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Storage bucket. Newer Firebase projects use *.firebasestorage.app;
# older ones use *.appspot.com. Copy from console → Storage.
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Additional client-side Firebase config. NOT READ by the current
# codebase — we only use the Admin SDK on the server. Set these once
# you start using the Firebase JS SDK in components (realtime listeners,
# client uploads, OTP signup). Leaving them blank does nothing today.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ──────────────────────────────────────────────────────────────────────
#  Security tuning (optional — sensible defaults baked in)
# ──────────────────────────────────────────────────────────────────────
#
# These tune the throttle and session helpers in src/server/auth/. The
# defaults are what production runs with; only override if you have a
# specific reason (e.g. tighter pilot policy, longer dev sessions).

# Max failed login attempts per IP before the lockout window kicks in.
# Default: 5
# LOGIN_MAX_ATTEMPTS=5

# Minutes the lockout lasts after the threshold is crossed.
# Default: 15
# LOGIN_LOCKOUT_MINUTES=15

# Hours a JWT cookie is valid before the user must sign in again.
# Default: 8 (one shift). Increase for development, decrease for pilot
# if you want shorter idle windows.
# SESSION_HOURS=8

# ──────────────────────────────────────────────────────────────────────
#  Razorpay — only when top-up payments go live
# ──────────────────────────────────────────────────────────────────────
# Leave blank to keep /billing top-ups in demo mode (which records a
# DEMOxxxxxx order id locally instead of hitting Razorpay).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ──────────────────────────────────────────────────────────────────────
#  Sentry error tracking — not wired yet, listed for the next phase
# ──────────────────────────────────────────────────────────────────────
# When @sentry/nextjs is added, set the DSN from sentry.io → project
# settings → Client Keys (DSN). Same DSN works for client and server.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
